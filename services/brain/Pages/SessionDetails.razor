@page "/session/{SessionIdParam}"
@using BrainService.Domain.Audio
@using BrainService.Proto.Brain
@using Microsoft.AspNetCore.SignalR.Client
@inject VoiceSessionService SessionService
@inject VoiceSessionHistoryService HistoryService
@inject NavigationManager Nav
@inject NodeRegistryService NodeRegistryService
@inject CommandPublisher CommandPublisher
@inject ISnackbar Snackbar
@implements IAsyncDisposable

@if (_session == null)
{
    @if (_isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudAlert Severity="Severity.Warning">Session @SessionIdParam not found.</MudAlert>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/">Return to Dashboard</MudButton>
    }
}
else
{
    <MudGrid>
        <!-- Header -->
        <MudItem xs="12" Class="d-flex">
            <MudStack StretchItems="StretchItems.None" AlignItems="AlignItems.Start">
                <MudText Typo="Typo.h4">Session Details</MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">Guild: @_session.GuildName</MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">Guild ID: @_session.GuildId</MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">Session ID: @_session.SessionId</MudText>
            </MudStack>
            <MudSpacer />
            <MudStack StretchItems="StretchItems.None" AlignItems="AlignItems.End">
                <SessionBadge State="@_session.MachineState" />
                <MudText Typo="Typo.caption" Class="mt-1">Last Updated: @GetTimeAgo(_session.LastUpdated)</MudText>
            </MudStack>
        </MudItem>

        <!-- Current state -->
        <MudItem xs="12">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent><MudText Typo="Typo.h5">Current State</MudText></CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="4">
                            <MudText Typo="Typo.h6">Channel</MudText>
                            <MudText Typo="Typo.body1">@_session.ChannelName</MudText>
                            <MudText Typo="Typo.body1">@_session.ChannelId</MudText>
                        </MudItem>
                        <MudItem xs="4">
                            <MudText Typo="Typo.h6">Last Known Node</MudText>
                            <MudText Typo="Typo.body1">@_session.NodeId</MudText>
                        </MudItem>
                        <MudItem xs="4">
                            <MudText Typo="Typo.h6">Connected Users (@(_session.Users.Count))</MudText>
                            <MudChipSet T="string">
                                @foreach (var user in _session.Users)
                                {
                                    var isSpeaking = _session.SpeakingUsers.Contains(user.UserId);
                                    <MudChip Color="@(isSpeaking ? Color.Success : Color.Default)"
                                             Variant="@(isSpeaking ? Variant.Filled : Variant.Outlined)"
                                             Icon="@(isSpeaking ? Icons.Material.Filled.Mic : Icons.Material.Filled.MicOff)">
                                        @user.DisplayName
                                    </MudChip>
                                }
                                @if (_session.Users.Count == 0)
                                {
                                    <MudText Typo="Typo.body2">No users connected</MudText>
                                }
                            </MudChipSet>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </MudItem>
        
        <!-- Actions -->
        <MudItem xs="12">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent><MudText Typo="Typo.h5">Actions</MudText></CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.CallEnd"
                               OnClick="@(async () => await EndSessionAsync())"
                               Disabled="@_isBusy">
                        End Session
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>
        
        <!-- Session Timeline -->
        <MudItem xs="12">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h5">Session Timeline</MudText>
                            @if (_eventsLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @_events.Count event(s)
                                </MudText>
                            }
                            @if (_llmStreaming)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                         Icon="@Icons.Material.Filled.FiberManualRecord">Generating...</MudChip>
                            }
                        </MudStack>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                       OnClick="@(async () => await LoadEventsAsync())"
                                       Disabled="@_eventsLoading" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent Class="pa-0">
                    @if (_events.Count == 0 && !_eventsLoading)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">No events recorded yet.</MudText>
                    }
                    else
                    {
                        <div class="pa-4">
                            <MudTimeline TimelinePosition="TimelinePosition.Start">
                                @foreach (var evt in VisibleEvents)
                                {
                                    <MudTimelineItem Color="@GetEventColor(evt.Type)"
                                                     Icon="@GetEventIcon(evt.Type)"
                                                     Size="Size.Small">
                                        <ItemContent>
                                            <MudStack Spacing="0">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @evt.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                                                    </MudText>
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                                             Color="@GetEventColor(evt.Type)">
                                                        @evt.Type
                                                    </MudChip>
                                                    @if (evt.UserId.HasValue)
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                            @GetDisplayName(evt)
                                                        </MudText>
                                                    }
                                                </MudStack>
                                                
                                                @if (evt.Type == VoiceSessionEventType.Transcript && evt.Data.Contains("text"))
                                                {
                                                    <MudText Typo="Typo.body2" Class="mt-1">
                                                        @evt.Data["text"].AsString
                                                    </MudText>
                                                    @if (evt.Data.Contains("language"))
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                            [@evt.Data["language"].AsString
                                                            · @(((float)evt.Data["confidence"].AsDouble).ToString("P0"))]
                                                        </MudText>
                                                    }
                                                }
                                                
                                                @if (evt.Type == VoiceSessionEventType.BotResponse && evt.Data.Contains("content"))
                                                {
                                                    var isPartial = evt.Data.Contains("is_partial") && evt.Data["is_partial"].AsBoolean;
                                                    <MudText Typo="Typo.body2" Class="mt-1"
                                                             Style="@(isPartial ? "opacity:0.7;font-style:italic" : "")">
                                                        @evt.Data["content"].AsString
                                                        @if (isPartial) { <text> [interrupted]</text> }
                                                    </MudText>
                                                    @if (evt.Data.Contains("generation_ms") && evt.Data["generation_ms"].AsInt32 > 0)
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                            [@evt.Data["generation_ms"].AsInt32 ms]
                                                        </MudText>
                                                    }
                                                }
                                                
                                                @if (evt.Type == VoiceSessionEventType.SystemNote && evt.Data.Contains("note"))
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1"
                                                             Style="font-style:italic">
                                                        @evt.Data["note"].AsString
                                                    </MudText>
                                                }
                                            </MudStack>
                                        </ItemContent>
                                    </MudTimelineItem>
                                }
                            </MudTimeline>
                        </div>

                        @switch (_timelineExpanded)
                        {
                            case false when _events.Count > TimelinePreviewCount:
                                <div @onclick=@(ExpandTimeline)
                                     style="cursor:pointer; margin-top:-80px; padding-top:80px;
                                        background: linear-gradient(to bottom, transparent, var(--mud-palette-surface));
                                        display:flex; flex-direction:column; align-items:center;
                                        padding-bottom:16px; user-select:none;">
                                    <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Color="Color.Secondary" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Show all @_events.Count events
                                    </MudText>
                                </div>
                                break;
                            case true when _events.Count > TimelinePreviewCount:
                                <div Class="d-flex justify-center pb-3">
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Text"
                                               StartIcon="@Icons.Material.Filled.ExpandLess"
                                               OnClick=@(() => CollapseTimeline())>
                                        Collapse
                                    </MudButton>
                                </div>
                                break;
                        }
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
        
        <!-- DSP Performance -->
        <MudItem xs="12">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h5">DSP Performance</MudText>
                            @if (_dspMetrics != null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success"
                                         Icon="@Icons.Material.Filled.FiberManualRecord">Live</MudChip>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @_dspMetrics.Timestamp.ToString("HH:mm:ss.fff")
                                </MudText>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default"
                                         Icon="@Icons.Material.Filled.FiberManualRecord">Waiting</MudChip>
                            }
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                            Queue depth = frames waiting in each node's output channel. Non-zero = backpressure.
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_dspMetrics == null)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            No data yet - metrics arrive once the audio graph is active.
                        </MudText>
                    }
                    else
                    {
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3">
                            @foreach (var node in _dspMetrics.Nodes)
                            {
                                var chipColor = node.QueueDepth switch
                                {
                                    0      => Color.Default,
                                    1 or 2 => Color.Success,
                                    3 or 4 => Color.Warning,
                                    _      => Color.Error
                                };
                                <MudPaper Outlined="true" Class="pa-3" Style="min-width:120px">
                                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                        <MudText Typo="Typo.caption">@node.Name</MudText>
                                        <MudChip T="string" Color="@chipColor" Size="Size.Small">@node.QueueDepth</MudChip>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">frames</MudText>
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                        <MudGrid Class="mt-4">
                            <MudItem xs="4">
                                <MudText Typo="Typo.h6">Average Total DSP Latency</MudText>
                                <MudText Typo="Typo.body1">@(_dspMetrics.AverageLatencyMs.ToString("F2")) ms</MudText>
                            </MudItem>
                        </MudGrid>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public required string SessionIdParam { get; set; }

    private const int TimelinePreviewCount = 10;

    private VoiceSessionState? _session;
    private DspSessionMetrics? _dspMetrics;
    private List<VoiceSessionEventDocument> _events = [];
    private HubConnection? _hubConnection;
    private bool _isLoading = true;
    private bool _eventsLoading;
    private bool _isBusy;
    private bool _timelineExpanded;
    private bool _llmStreaming;

    private IEnumerable<VoiceSessionEventDocument> VisibleEvents =>
        (_timelineExpanded
            ? _events
            : _events.TakeLast(TimelinePreviewCount)).Reverse();

    protected override async Task OnInitializedAsync()
    {
        await LoadSession();
        await LoadEventsAsync();

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/hub/dashboard"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<VoiceSessionState>("SessionUpdated", OnSessionUpdated);
        _hubConnection.On<DspSessionMetrics>("DspMetricsUpdated", OnDspMetricsUpdated);
        _hubConnection.On<string>("TranscriptReceived", OnTranscriptReceived);
        _hubConnection.On<string>("LlmResponseChunk", OnLlmResponseChunk);
        _hubConnection.On<string>("LlmResponseCompleted", OnLlmResponseCompleted);
        _hubConnection.On<string>("LlmResponseCanceled", OnLlmResponseCancelled);

        await _hubConnection.StartAsync();
    }

    private async Task LoadSession()
    {
        _isLoading = true;
        try { _session = await SessionService.GetSessionStateAsync(SessionIdParam); }
        finally { _isLoading = false; }
    }

    private async Task LoadEventsAsync()
    {
        _eventsLoading = true;
        try { _events = await HistoryService.GetEventsAsync(SessionIdParam, limit: 500); }
        finally { _eventsLoading = false; }
        StateHasChanged();
    }

    private void OnSessionUpdated(VoiceSessionState session)
    {
        if (session.SessionId != SessionIdParam) return;
        InvokeAsync(() =>
        {
            var userCountChanged = _session == null || _session.Users.Count != session.Users.Count;
            _session = session; 
            StateHasChanged();

            if (userCountChanged)
            {
                _ = LoadEventsAsync();
            }
        });
    }

    private void OnDspMetricsUpdated(DspSessionMetrics metrics)
    {
        if (metrics.SessionId != SessionIdParam) return;
        InvokeAsync(() => { _dspMetrics = metrics; StateHasChanged(); });
    }

    private void OnTranscriptReceived(string sessionId)
    {
        if (sessionId != SessionIdParam) return;
        InvokeAsync(LoadEventsAsync);
    }
    
    private void OnLlmResponseChunk(string sessionId)
    {
        if (sessionId != SessionIdParam) return;
        InvokeAsync(() => { _llmStreaming = true; StateHasChanged(); });
    }

    private void OnLlmResponseCompleted(string sessionId)
    {
        if (sessionId != SessionIdParam) return;
        InvokeAsync(async () =>
        {
            _llmStreaming = false;
            await LoadEventsAsync();
        });
    }

    private void OnLlmResponseCancelled(string sessionId)
    {
        if (sessionId != SessionIdParam) return;
        InvokeAsync(async () =>
        {
            _llmStreaming = false;
            await LoadEventsAsync();
        });
    }

    private void ExpandTimeline()  { _timelineExpanded = true;  StateHasChanged(); }
    private void CollapseTimeline() { _timelineExpanded = false; StateHasChanged(); }

    private string GetDisplayName(VoiceSessionEventDocument evt)
    {
        if (evt.UserId is null) return string.Empty;

        var user = _session?.Users.FirstOrDefault(u => (long)u.UserId == evt.UserId.Value);
        if (user != null) return user.DisplayName;

        if (evt.Data.TryGetValue("display_name", out var nameElement) &&
            nameElement.BsonType == MongoDB.Bson.BsonType.String)
        {
            return nameElement.AsString;
        }
        
        return $"User {evt.UserId}";
    }

    private async Task EndSessionAsync()
    {
        if (_session == null) return;
        _isBusy = true;
        try
        {
            var nodeId = await NodeRegistryService.GetNodeForGuildAsync(_session.GuildId);
            if (string.IsNullOrEmpty(nodeId))
            {
                Snackbar.Add("No active node found for this session.", Severity.Error);
                return;
            }
            await CommandPublisher.PublishCommandAsync(nodeId, new BrainCommand
            {
                Disconnect = new DisconnectVoice
                {
                    Guild     = new GuildContext { Id = _session.GuildId },
                    SessionId = _session.SessionId
                }
            });
            Snackbar.Add("End Session command sent.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Failed to send command: {ex.Message}", Severity.Error); }
        finally { _isBusy = false; }
    }

    private static Color GetEventColor(VoiceSessionEventType type) => type switch
    {
        VoiceSessionEventType.Transcript  => Color.Primary,
        VoiceSessionEventType.BotResponse => Color.Secondary,
        VoiceSessionEventType.SystemNote  => Color.Default,
        VoiceSessionEventType.UserJoined  => Color.Success,
        VoiceSessionEventType.UserLeft    => Color.Warning,
        VoiceSessionEventType.Started     => Color.Info,
        VoiceSessionEventType.Ended       => Color.Dark,
        _ => Color.Default,
    };

    private static string GetEventIcon(VoiceSessionEventType type) => type switch
    {
        VoiceSessionEventType.Transcript  => Icons.Material.Filled.RecordVoiceOver,
        VoiceSessionEventType.BotResponse => Icons.Material.Filled.SmartToy,
        VoiceSessionEventType.SystemNote  => Icons.Material.Filled.Info,
        VoiceSessionEventType.UserJoined  => Icons.Material.Filled.PersonAdd,
        VoiceSessionEventType.UserLeft    => Icons.Material.Filled.PersonRemove,
        VoiceSessionEventType.Started     => Icons.Material.Filled.PlayCircle,
        VoiceSessionEventType.Ended       => Icons.Material.Filled.StopCircle,
        _ => Icons.Material.Filled.Info,
    };

    private static string GetTimeAgo(DateTime lastUpdated)
    {
        var span = DateTime.UtcNow - lastUpdated;
        return span.TotalSeconds < 60 ? "Just now" : $"{span.TotalMinutes:F0}m ago";
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null) await _hubConnection.DisposeAsync();
    }
    
}
