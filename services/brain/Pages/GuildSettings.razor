@page "/guild-settings"
@using BrainService.Domain.Llm
@using BrainService.Domain.Tts
@using BrainService.Services.Llm
@using BrainService.Services.Tts
@using BrainService.Shared.Components.GuildSettings
@inject GuildSettingsService SettingsService
@inject OllamaModelService OllamaModelService
@inject VoiceSessionHistoryService HistoryService
@inject ISnackbar Snackbar
@inject TtsVoiceRegistry TtsVoiceRegistry

<MudText Typo="Typo.h4" Class="mb-4">Guild LLM Settings</MudText>

<MudGrid>
    <!-- Guild Picker -->
    <MudItem xs="12">
        <MudCard>
            <MudCardContent>
                <MudGrid AlignItems="AlignItems.Center">
                    <MudItem xs="12" sm="8" md="6">
                        <MudSelect T="ulong?" Label="Select Guild" Value="_selectedGuildId"
                                   ValueChanged="OnGuildSelected" Variant="Variant.Outlined" Dense="true"
                                   Placeholder="Pick a guild to edit...">
                            @foreach (var guild in _knownGuilds)
                            {
                                <MudSelectItem T="ulong?" Value="@((ulong?)guild.GuildId)">
                                    @guild.GuildName (@guild.GuildId)
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Editor -->
    @if (_isLoading)
    {
        <MudItem xs="12" Class="d-flex justify-center mt-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </MudItem>
    }
    else if (_selectedGuildId.HasValue && _edit != null && _defaults != null)
    {
        <MudItem xs="12">
            <MudAlert Severity="Severity.Info" Dense="true">
                Editing Guild <strong>@_selectedGuildId</strong>.
                Fields marked with <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" /> override the server default.
                Uncheck a field to revert it to the default.
            </MudAlert>
        </MudItem>
        
        <MudItem xs="12">
            <GuildIdentityCard Edit="@_edit" Defaults="@_defaults" />
        </MudItem>

        <MudItem xs="12">
            <GuildModelCard Edit="@_edit" Defaults="@_defaults" AvailableModels="@_availableModels" />
        </MudItem>
        
        <MudItem xs="12">
            <GuildTtsCard Edit="@_edit" Defaults="@_defaults" AvailableVoices="@_availableVoices" />
        </MudItem>

        <MudItem xs="12">
            <GuildGenerationCard Edit="@_edit" Defaults="@_defaults" />
        </MudItem>

        <MudItem xs="12">
            <GuildTimingCard Edit="@_edit" Defaults="@_defaults" />
        </MudItem>

        <MudItem xs="12">
            <GuildRambleModeCard Edit="@_edit" Defaults="@_defaults"
                                 IsSaving="@_isSaving"
                                 OnSave="@SaveAsync"
                                 OnResetAll="@ResetAllAsync" />
        </MudItem>
    }
</MudGrid>

@code {
    private List<(long GuildId, string GuildName)> _knownGuilds = [];
    private List<string> _availableModels = [];
    private List<TtsVoiceDefinition> _availableVoices = [];

    private ulong? _selectedGuildId;

    private GuildLlmSettings? _edit;
    private ResolvedLlmSettings? _defaults;
    private bool _isLoading;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        _knownGuilds = await HistoryService.GetKnownGuildsAsync();
        _defaults = SettingsService.GetDefaults();
        
        _availableVoices = TtsVoiceRegistry.Voices.ToList();

        try
        {
            var models = await OllamaModelService.GetAvailableModelsAsync();
            _availableModels = models.ToList();
        }
        catch
        {
            // Ollama might not be reachable at dashboard load time - that's fine
        }
    }

    private async Task OnGuildSelected(ulong? guildId)
    {
        if (guildId.HasValue)
            await LoadGuild(guildId.Value);
        else
        {
            _selectedGuildId = null;
            _edit = null;
        }
    }

    private async Task LoadGuild(ulong guildId)
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            _selectedGuildId = guildId;
            var raw = await SettingsService.GetRawSettingsAsync(guildId);
            _edit = raw is null
                ? new GuildLlmSettings { GuildId = guildId }
                : CloneSettings(raw);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveAsync()
    {
        if (_edit is null || _selectedGuildId is null) return;
        _isSaving = true;
        try
        {
            _edit.GuildId = _selectedGuildId.Value;
            await SettingsService.SaveSettingsAsync(_edit);
            Snackbar.Add("Settings saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ResetAllAsync()
    {
        if (_selectedGuildId is null) return;
        _isSaving = true;
        try
        {
            await SettingsService.DeleteSettingsAsync(_selectedGuildId.Value);
            _edit = new GuildLlmSettings { GuildId = _selectedGuildId.Value };
            Snackbar.Add("All overrides cleared - guild is using server defaults.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Reset failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static GuildLlmSettings CloneSettings(GuildLlmSettings s) => new()
    {
        GuildId                 = s.GuildId,
        SystemPrompt            = s.SystemPrompt,
        CustomInstructions      = s.CustomInstructions,
        BotName                 = s.BotName,
        ModelName               = s.ModelName,
        Temperature             = s.Temperature,
        MaxTokens               = s.MaxTokens,
        ContextWindow           = s.ContextWindow,
        SilenceThresholdMs      = s.SilenceThresholdMs,
        UserJoinGraceMs         = s.UserJoinGraceMs,
        RambleModeEnabled       = s.RambleModeEnabled,
        RambleThresholdMs       = s.RambleThresholdMs,
        RambleSystemHint        = s.RambleSystemHint,
        RambleMinResponseLength = s.RambleMinResponseLength,
        EnabledTools            = s.EnabledTools,
        ToolsEnabled            = s.ToolsEnabled,
        TimeZone                = s.TimeZone,
        TtsVoiceId              = s.TtsVoiceId,
    };
}
