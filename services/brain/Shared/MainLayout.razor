@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="true" Theme="@_customTheme"/>
<MudDialogProvider/>
<MudSnackbarProvider/>
<MudPopoverProvider/>

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(e => ToggleDrawer())" Class="mr-3"/>
        <MudText Typo="Typo.h6">Narek Chatencjusz Brain Control Panel</MudText>
    </MudAppBar>
    
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
        <MudNavLink Href="/nodes" Icon="@Icons.Material.Filled.Computer">Nodes</MudNavLink>
        <MudNavLink Href="/guild-settings" Icon="@Icons.Material.Filled.Tune">Guild Settings</MudNavLink>
        <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">Global Settings</MudNavLink>
    </MudDrawer>
    
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;
    void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    readonly MudTheme _customTheme = new()
    {
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Source Sans 3", "Arial", "sans-serif"]
            }
        }
    };
}
