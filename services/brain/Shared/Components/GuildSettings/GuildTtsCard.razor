@using BrainService.Domain.Guild
@using BrainService.Domain.Tts
@using BrainService.Shared.Components.Utils

<MudCard>
    <MudCardHeader>
        <CardHeaderContent><MudText Typo="Typo.h6">Text-to-Speech</MudText></CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" sm="6" md="4">
                <OverrideField Label="TTS Voice"
                               IsOverridden="@(Edit.TtsVoiceId != null)"
                               IsOverriddenChanged="v => { Edit.TtsVoiceId = !v ? null : string.Empty; }"
                               DefaultHint="@(Defaults.TtsVoiceId ?? "None (TTS disabled)")">
                    @if (AvailableVoices.Count > 0)
                    {
                        <MudSelect @bind-Value="Edit.TtsVoiceId"
                                   Variant="Variant.Outlined"
                                   Placeholder="@(Defaults.TtsVoiceId ?? "Select a voice...")">
                            <MudSelectItem T="string?" Value="@((string?)null)">
                                <em>None (disable TTS)</em>
                            </MudSelectItem>
                            @foreach (var voice in AvailableVoices)
                            {
                                <MudSelectItem T="string?" Value="@voice.VoiceId">
                                    @voice.DisplayName
                                    <MudText Typo="Typo.caption" Class="ml-2" Color="Color.Secondary">
                                        (@voice.ProviderType.ToString())
                                    </MudText>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudTextField @bind-Value="Edit.TtsVoiceId"
                                      Variant="Variant.Outlined"
                                      Placeholder="Voice ID (no voices configured in appsettings.json)"
                                      HelperText="Add voices under Tts:Voices in appsettings.json." />
                    }
                </OverrideField>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <OverrideField Label="Interrupt Threshold (ms)"
                               IsOverridden="@(Edit.InterruptThresholdMs != null)"
                               IsOverriddenChanged="v => { Edit.InterruptThresholdMs = !v ? null : Defaults.InterruptThresholdMs; }"
                               DefaultHint="@Defaults.InterruptThresholdMs.ToString()">
                    <MudNumericField @bind-Value="Edit.InterruptThresholdMs"
                                     Variant="Variant.Outlined"
                                     Min="0" Max="10000" />
                </OverrideField>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <OverrideField Label="Soundboard Buffer (ms)"
                               IsOverridden="@(Edit.SoundboardDrainBufferMs != null)"
                               IsOverriddenChanged="v => { Edit.SoundboardDrainBufferMs = !v ? null : Defaults.SoundboardDrainBufferMs; }"
                               DefaultHint="@Defaults.SoundboardDrainBufferMs.ToString()">
                    <MudNumericField @bind-Value="Edit.SoundboardDrainBufferMs"
                                     Variant="Variant.Outlined"
                                     Min="0" Max="2000" />
                </OverrideField>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired] public GuildSettings Edit { get; set; } = null!;
    [Parameter, EditorRequired] public ResolvedGuildSettings Defaults { get; set; } = null!;
    [Parameter] public List<TtsVoiceDefinition> AvailableVoices { get; set; } = [];
}
