{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Components.Server.Circuits": "None"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://*:5050",
        "Protocols": "Http2"
      }
    }
  },
  "Valkey": {
    "Url": "localhost:6379"
  },
  "Audio": {
    "VadModelUrl": "https://raw.githubusercontent.com/snakers4/silero-vad/master/src/silero_vad/data/silero_vad.onnx"
  },
  "AllowedHosts": "*"
}
