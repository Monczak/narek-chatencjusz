{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Components.Server.Circuits": "None"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://*:5050",
        "Protocols": "Http2"
      }
    }
  },
  "Audio": {
    "VadModelUrl": "https://raw.githubusercontent.com/snakers4/silero-vad/master/src/silero_vad/data/silero_vad.onnx"
  },
  "Asr": {
    "Url": "localhost:6060"
  },
  "Valkey": {
    "Url": "localhost:6379"
  },
  "Mongo": {
    "Url": "mongodb://localhost:27017",
    "Database": "narek-chatencjusz"
  },
  "Llm": {
    "SystemPromptFile": "../../prompts/system_prompt.txt",
    "RambleHintFile": "../../prompts/ramble_hint.txt",
    "Defaults": {
      "BotName": "Narek Narencjusz",
      "ProviderType": "ollama",
      "ProviderUrl": "http://localhost:11434",
      "MaxTokens": 1024,
      "Temperature": 0.1,
      "SilenceThresholdMs": 1500,
      "UserJoinGraceMs": 3000,
      "RambleModeEnabled": false,
      "RambleThresholdMs": 90000,
      "RambleMinResponseLength": 10,
      "TimeZone": "Europe/Warsaw"
    }
  }
}
