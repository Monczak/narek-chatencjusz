{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://*:5050",
        "Protocols": "Http2"
      }
    }
  },
  "Valkey": {
    "Url": "localhost:6379"
  }
}
